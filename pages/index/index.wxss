/* pages/index/index.wxss */
.nav-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-item {
  padding: 10rpx 30rpx;
  font-size: 28rpx;
  color: #666;
}

.nav-item text {
  position: relative;
}

.nav-item text::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 4rpx;
  background: #fa2a2a;
  transition: width 0.3s;
}

.nav-item:active {
  color: #fa2a2a;
}

.search-bar {
  padding: 20rpx;
  background: #fff;
}

.search-bar input {
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}

.banner {
  width: 100%;
  height: 300rpx;
}

.banner image {
  width: 100%;
  height: 100%;
}

.section-title {
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  background: #fff;
  margin-top: 20rpx;
}

.goods-list {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
}

.goods-item {
  width: 48%;
  margin: 1%;
  background: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.goods-item image {
  width: 100%;
  height: 300rpx;
}

.goods-info {
  padding: 20rpx;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price {
  display: flex;
  align-items: center;
}

.goods-price .price {
  font-size: 32rpx;
}
