<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="nav-item" bindtap="navigateTo" data-page="index">
      <text>首页</text>
    </view>
    <view class="nav-item" bindtap="navigateTo" data-page="category">
      <text>分类</text>
    </view>
    <view class="nav-item" bindtap="navigateTo" data-page="cart">
      <text>购物车</text>
    </view>
    <view class="nav-item" bindtap="navigateTo" data-page="user">
      <text>我的</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input type="text" placeholder="搜索商品" bindconfirm="onSearch" />
  </view>

  <!-- 轮播图 -->
  <swiper class="banner" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{3000}}">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image src="{{item.image}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <!-- 商品列表 -->
  <view class="section-title">热门商品</view>
  <view class="goods-list">
    <view
      class="goods-item"
      wx:for="{{goodsList}}"
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item._id}}"
    >
      <image src="{{item.images[0]}}" mode="aspectFill" />
      <view class="goods-info">
        <view class="goods-name">{{item.name}}</view>
        <view class="goods-desc">{{item.description}}</view>
        <view class="goods-price">
          <text class="price">¥{{item.price}}</text>
          <text wx:if="{{item.original_price}}" class="original-price">¥{{item.original_price}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
