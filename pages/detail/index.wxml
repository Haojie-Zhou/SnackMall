<!--pages/detail/index.wxml-->
<view class="container">
  <!-- 商品图片 -->
  <swiper class="goods-swiper" indicator-dots="{{true}}">
    <swiper-item wx:for="{{goods.images}}" wx:key="index">
      <image src="{{item}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <!-- 商品信息 -->
  <view class="goods-info">
    <view class="price-row">
      <text class="price">¥{{goods.price}}</text>
      <text wx:if="{{goods.originalPrice}}" class="original-price">¥{{goods.originalPrice}}</text>
    </view>
    <view class="goods-name">{{goods.name}}</view>
    <view class="goods-desc">{{goods.desc}}</view>
    <view class="goods-sales">已售 {{goods.sales}} 件</view>
  </view>

  <!-- 商品详情 -->
  <view class="goods-detail">
    <view class="detail-title">商品详情</view>
    <view class="detail-content">
      <image wx:for="{{goods.detailImages}}" wx:key="index" src="{{item}}" mode="widthFix" />
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="action-left">
      <view class="action-item" bindtap="toggleFavorite">
        <image src="{{isFavorite ? '/images/favorite-active.png' : '/images/favorite.png'}}" />
        <text>{{isFavorite ? '已收藏' : '收藏'}}</text>
      </view>
      <view class="action-item" bindtap="addToCart">
        <image src="/images/add-cart.png" />
        <text>购物车</text>
      </view>
    </view>
    <view class="action-right">
      <button class="btn-add-cart" bindtap="addToCart">加入购物车</button>
      <button class="btn-buy-now" bindtap="buyNow">立即购买</button>
    </view>
  </view>
</view>
