/* pages/category/index.wxss */
.category-layout {
  display: flex;
  height: calc(100vh - 50px);
}

.category-left {
  width: 200rpx;
  background: #f5f5f5;
}

.category-item {
  padding: 30rpx 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  border-bottom: 1rpx solid #e5e5e5;
}

.category-item.active {
  background: #fff;
  color: #fa2a2a;
  border-left: 4rpx solid #fa2a2a;
}

.category-right {
  flex: 1;
  padding: 20rpx;
  background: #fff;
}

.category-title {
  padding: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.goods-list {
  display: flex;
  flex-wrap: wrap;
}

.goods-item {
  width: 48%;
  margin: 1%;
  border-radius: 10rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.goods-item image {
  width: 100%;
  height: 200rpx;
}

.goods-info {
  padding: 15rpx;
}

.goods-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
