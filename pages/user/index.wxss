/* pages/user/index.wxss */
.user-header {
  display: flex;
  align-items: center;
  padding: 60rpx 30rpx;
  background: linear-gradient(135deg, #fa2a2a 0%, #ff6b6b 100%);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  margin-right: 30rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.login-btn {
  font-size: 28rpx;
  color: #fff;
  opacity: 0.9;
}

.order-status {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 0;
  background: #fff;
  margin-top: -20rpx;
  border-radius: 20rpx 20rpx 0 0;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-item image {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.status-item text {
  font-size: 24rpx;
  color: #666;
}

.menu-list {
  margin-top: 20rpx;
  background: #fff;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.menu-item text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  color: #999;
  font-size: 32rpx;
}
